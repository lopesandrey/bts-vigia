# Copy to .env and fill in. NEVER put the real token in this file —
# only .env is in .gitignore.

# From @BotFather on Telegram.
BOT_TOKEN=123456789:AA-put-your-token-here

# The group the alerts go to. Groups have a negative id, e.g. -1001234567890.
# To find it: add the bot to the group, send any message, then run
#   .venv/bin/python chat_id.py
CHAT_ID=-1001234567890

# SECONDS between checks (not minutes). Good listings appear and vanish within
# minutes, so this is a real-time watcher, not a daily report.
#
# 30 is the default and the recommendation. Measured against the rewritten API:
# one round is 12 requests (3 noites x 4 setores) of ~500 bytes each, about 6 KB
# total — menos bytes do que antes, em mais chamadas. You can go down to 15 if
# you want to be aggressive. Minimum accepted: 10. Below that you are asking for
# an IP ban, and a banned IP is permanent blindness — far worse than being 30
# seconds late.
INTERVAL_SECONDS=30

# Maximum acceptable markup, in % over face value.
#   36 = face + booking fee + a 20% premium. On Pista that is R$ 1,700.
#        It is the right number, which is why it is the default.
#
# To TEST that alerts arrive, set 240 for one round: it is loose enough to catch
# today's cheapest listing and fires on the first check. Then go back to 36 — or
# send /agio 36 in the group, no restart needed.
MAX_MARKUP=36

# Categories that can trigger an alert, comma separated. Only list what you can
# actually prove at the gate — half-price with no proof is entry denied.
# Valid for THIS event (28/09/2026): Inteira, Meia Estudante, Meia Idoso,
#        Meia PCD, Meia Jovem Baixa Renda, Meia Professor, Meia aposentado,
#        Meia Até 21, Meia Pessoas Tea, Meia Profissional da Saúde,
#        Acompanhante PCD
# O site mexe nessa lista: um nome que ele não vende mais derruba o boot com a
# lista válida, em vez de deixar o bot mudo pra sempre.
CATEGORIES=Inteira,Meia Estudante

# --- to actually buy (required — buying is what this bot does) -----------------
# Without these the bot still watches and alerts, but it can never reserve
# anything: it says so at boot and in every 🔑 warning, and then you are racing
# by hand. Buying on its own is the default and there is no command to turn it
# on — /armar only ever undoes a stop.

# Your buyticketbrasil login. ATENÇÃO: o site loga com CPF, não com e-mail — o
# CPF abaixo é a sua credencial. O bot entra sozinho e guarda os cookies em
# .auth/cookies.txt (chmod 600), então isso aqui é o único lugar com a senha.
PASS=put-your-site-password-here
CPF=00000000000

# Cobrança do pedido.
POSTAL_CODE=01310100
NUMBER=123
COMPLEMENT=
# Rua, bairro, cidade e estado: opcionais, e vale preencher. Em branco, o bot
# pergunta ao viacep.com.br pelo CEP — que é o que o site faz — e essa é a única
# chamada do fluxo de compra que sai do buyticketbrasil, ou seja, o único passo
# que pode falhar por motivo nenhum a ver com o ingresso. Preenchidos, o bot nem
# consulta. É tudo ou nada: o pedido recusa endereço pela metade, e o boot avisa
# e volta pro viacep se você deixar só alguns.
STREET=
NEIGHBORHOOD=
CITY=
STATE=
# Opcional: o nome que vai na cobrança. Vazio = o nome da própria conta, que é o
# certo em quase todo caso.
NAME=

# Quem recebe o ingresso. O vendedor transfere pra esse e-mail na bilheteria
# oficial, então ele precisa estar certo. EMAIL serve de reserva.
RECEIVER_EMAIL=you@example.com
EMAIL=you@example.com

# A flat ceiling in reais per ticket, on top of the MAX_MARKUP maths. It is not
# redundant: the markup cap depends on reading the sector name right and on the
# face-value table, and if the site renames a sector that arithmetic can approve
# a price it should not. A bare number cannot be reasoned wrong, and this is the
# last gate before money leaves. Pista at 36% markup is R$ 1,700.
HARD_CEILING=2000

# --- second account, for testing the purchase (optional) ----------------------
# Nothing reads these at run time. They exist because `lock` and `POST /orders`
# have no sandbox: the only way to prove those endpoints is to create a real
# order, and a real order on the account that will actually buy the ticket is not
# something to do casually. Filled in, a maintainer can run the whole flow on a
# throwaway account and generate a Pix charge nobody pays (it expires on its own).
#
# Two rules if you ever do that. Point the cookie jar somewhere else
# (`checkout.AUTH_FILE = ROOT / ".auth" / "test-cookies.txt"`) so the real
# session survives, and aim at the MOST expensive listing on the board — the
# reservation holds a real ticket for ten minutes, and the dearest listing is the
# one no human is racing you for.
TEST_CPF=
TEST_PASS=
TEST_EMAIL=
TEST_NAME=
TEST_PHONE=
TEST_POSTAL_CODE=
TEST_STREET=
TEST_NUMBER=
TEST_NEIGHBORHOOD=
TEST_CITY=
TEST_STATE=
